# Values for the live site once the backend runs on your own server.
# Set these in the Hostinger deployment environment, then rebuild the site.

# Public backend address and public key (safe to expose in the browser)
VITE_SUPABASE_URL="https://api.yourdomain.com"
VITE_SUPABASE_PUBLISHABLE_KEY="<ANON_KEY from the VPS .env>"
VITE_SUPABASE_PROJECT_ID="selfhosted"

# Same values for server-side rendering
SUPABASE_URL="https://api.yourdomain.com"
SUPABASE_PUBLISHABLE_KEY="<ANON_KEY from the VPS .env>"

# Secret — server only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY="<SERVICE_ROLE_KEY from the VPS .env>"
