# Prevent execution of PHP, scripts, SVGs, HTML, or executables inside /uploads/
<IfModule mod_autoindex.c>
  IndexIgnore *
</IfModule>

<FilesMatch "\.(?i:php|php[0-9]|phtml|phar|pl|py|rb|cgi|sh|bash|asp|aspx|jsp|html|htm|xhtml|svg|svgz|js|mjs|vbs|exe|dll|bat|cmd|msi|com|scr)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Content-Security-Policy "default-src 'none'"
</IfModule>

